# Copy to .env.local (git-ignored) and fill in.
# Without email settings, dev mode prints sign-in codes to the terminal running `npm run dev`.

# Long random string used to sign one-time codes. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# MongoDB connection string (Atlas: Database > Connect > Drivers). REQUIRED.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=keep-it-sorted

# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
SMTP_FROM="Your Brand <you@gmail.com>"

# Or any other SMTP provider instead of Gmail (Resend, Brevo, Postmark, ...)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
